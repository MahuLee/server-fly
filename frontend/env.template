# 前端环境变量配置模板
# 
# 使用说明：
# 1. 复制此文件内容
# 2. 在 frontend 目录下创建 .env 文件
# 3. 将内容粘贴到 .env 文件中
# 4. 根据实际情况修改配置值
# 5. 重启开发服务器

# ============================================
# API 配置
# ============================================

# 后端 API 基础 URL
# 开发环境: http://localhost:3001
# 生产环境: https://api.yourdomain.com
REACT_APP_API_BASE_URL=http://localhost:3001

# ============================================
# WebSocket 配置
# ============================================

# WebSocket 服务器主机地址
# 开发环境: localhost
# 生产环境: api.yourdomain.com
REACT_APP_WS_HOST=localhost

# WebSocket 服务器端口
# 开发环境: 3001
# 生产环境: 443 (使用 wss) 或 80 (使用 ws)
REACT_APP_WS_PORT=3001
