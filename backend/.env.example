# ============================================
# ServerFLY 配置文件：请注意
# ============================================
# 编码：UTF-8
# 说明：该文件用于配置服务端的相关设置，确保在 .env 文件中提供必要的参数。
# 警告：env 文件需要包含所有必需的配置项。
# ============================================

# --------------------------------------------
# 服务端配置
# --------------------------------------------

# 服务端监听端口：默认值3001
# 说明：用于API服务端的HTTP端口
PORT=3001

# --------------------------------------------
# WebSocket 配置
# --------------------------------------------

# WebSocket 心跳间隔：默认值30
# 说明：用于保持连接的ping消息的发送频率
# 默认值范围：20-60
WEBSOCKET_PING_INTERVAL=30

# --------------------------------------------
# 数据推送配置
# --------------------------------------------

# 数据推送延迟时间：默认值500
# 说明：用于控制数据推送的延迟时间
# 默认值范围：
#   - 数据推送延迟时间：200-300ms
#   - 心跳间隔：60ms
#   - 推送间隔：20ms
PUSH_DEBOUNCE_MS=500

# 心跳间隔：默认值30
# 说明：用于检测连接的心跳频率
PUSH_HEARTBEAT_INTERVAL=30

# --------------------------------------------
# 数据库配置
# --------------------------------------------

# 数据库存储路径：默认值data/monitoring.db
# 说明：SQLite数据库存储的路径
DB_PATH=data/monitoring.db

# --------------------------------------------
# 健康检查配置
# --------------------------------------------

# 默认健康检查间隔：默认值30
# 说明：用于执行健康检查的频率
HEALTH_CHECK_INTERVAL=30

# 默认健康检查超时：默认值5
# 说明：健康检查请求的超时时间
HEALTH_CHECK_TIMEOUT=5

# 默认健康检查重试次数：默认值3
# 说明：健康检查失败后的重试次数
HEALTH_CHECK_RETRIES=3

# --------------------------------------------
# 指标收集配置
# --------------------------------------------

# 默认指标收集间隔：默认值60
# 说明：用于收集指标数据的频率
METRICS_COLLECTION_INTERVAL=60

# 指标数据保留天数：默认值3
# 说明：用于保留指标数据的天数
DATA_RETENTION_DAYS=3

# --------------------------------------------
# 日志配置
# --------------------------------------------

# 日志级别：默认值info
# 说明：可选值为debug, info, warn, error
LOG_LEVEL=info

# 是否启用详细日志：默认值false
# 说明：启用后将记录详细的日志信息
VERBOSE_LOGGING=false

# --------------------------------------------
# CORS 配置
# --------------------------------------------

# 允许的源：默认值http://localhost:3000,http://localhost:3003
# 说明：允许跨源请求的来源
CORS_ORIGINS=http://localhost:3000,http://localhost:3003

# --------------------------------------------
# 连接池配置
# --------------------------------------------

# 数据库连接池大小：默认值10
# 说明：用于控制数据库连接池的大小
DB_POOL_SIZE=10

# 请求超时时间：默认值30000
# 说明：HTTP请求的超时时间
REQUEST_TIMEOUT=30000

# --------------------------------------------
# 认证配置
# --------------------------------------------

# API 密钥：可选
# 说明：用于认证的API密钥
API_KEY=

# 是否启用 HTTPS：默认值false
# 说明：设置为true以启用HTTPS
ENABLE_HTTPS=false

# SSL 证书路径：可选
# 说明：用于HTTPS的SSL证书路径
SSL_CERT_PATH=
# SSL 密钥路径：可选
# 说明：用于HTTPS的SSL密钥路径
SSL_KEY_PATH=

# --------------------------------------------
# 开发模式配置
# --------------------------------------------

# 开发模式：默认值false
# 说明：启用后将输出调试信息
DEV_MODE=false

# 模拟数据模式：默认值false
# 说明：启用后将使用模拟数据而不是真实数据
MOCK_DATA=false

# --------------------------------------------
# 配置说明
# --------------------------------------------
# 
# 1. 一般配置项
#    - PORT：默认值3001
#    - WEBSOCKET_PING_INTERVAL
#    - PUSH_DEBOUNCE_MS
#    - PUSH_HEARTBEAT_INTERVAL
#
# 2. 认证配置
#    - 其他相关配置项需确保在正确环境下使用
# 3. 配置文件优先级
#    - .env文件中的配置 > 默认值
# 4. 配置变更
#    - 修改配置项后需重启服务
# 5. 配置验证
#    - 启动时需验证配置的有效性
#
# ============================================
# 配置文件结束
# ============================================